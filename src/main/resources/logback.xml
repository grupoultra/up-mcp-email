<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Suppress Logback status messages that would pollute stdout -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <!-- Log to stderr to keep stdout clean for STDIO transport -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File appender for persistent logs -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${user.home}/Library/Logs/up-mcp-email/server.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${user.home}/Library/Logs/up-mcp-email/server.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Quiet down noisy libraries -->
    <logger name="org.eclipse.jetty" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="org.eclipse.angus" level="WARN"/>
    <logger name="jakarta.mail" level="WARN"/>
    <logger name="com.google.auth" level="WARN"/>
    <logger name="org.xbill.DNS" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
